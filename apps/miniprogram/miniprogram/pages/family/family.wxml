<view class="page stack">
  <view class="quiet">{{familyTodo}}</view>
  <view class="headline">{{title}}</view>
  <empty-child bind:add="onAddChild" />
  <button class="row-link" bindtap="openReminders">
    <text>{{reminders}}</text>
    <text class="quiet">{{reminderRow}}</text>
  </button>
  <button class="row-link" bindtap="openSettings">
    <text>{{settings}}</text>
    <text class="quiet">{{settingsSubtitle}}</text>
  </button>
</view>
<view wx:if="{{addOpen}}" class="dialog-back">
  <view class="dialog stack">
    <view class="headline">{{addTitle}}</view>
    <view>{{addBody}}</view>
    <view>{{addBlocked}}</view>
    <button class="text-button" bindtap="onCloseAdd">{{closeLabel}}</button>
  </view>
</view>

<view wx:if="{{privacyMask}}" class="privacy-mask"></view>
