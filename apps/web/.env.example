# Public client configuration only. Leave values empty in git.
# Never put a service-role key, database password, or model provider key here.
# NEXT_PUBLIC_ values are shipped to the browser. Use the Supabase publishable
# or anon key, the same value iOS sends as the apikey header.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_CATPAW_EDGE_ORIGIN=
# Server-only origin of this site, used for OAuth redirects and CSRF checks.
# Example: https://mimi.example
# Leave empty for local loopback. A loopback Host is used; a forwarded host is ignored.
MIMI_WEB_SITE_URL=
# Server-only HMAC-SHA256 key for the session meta cookie (seenAt and the lock flag).
# Required in production: a missing key, missing cookie, or bad signature locks the session.
# Leave empty for local dev. Never commit a real value.
MIMI_WEB_SESSION_SECRET=
